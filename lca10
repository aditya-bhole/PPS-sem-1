#include <stdio.h>

/* Returns 1 if year is a leap year, else 0 (Gregorian rules) */
int isLeap(int year)
{
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

/* Day of week for 1 January of the given year: 0 = Sunday ... 6 = Saturday */
int firstDayOfYear(int year)
{
    int y = year - 1;
    return (1 + 5 * (y % 4) + 4 * (y % 100) + 6 * (y % 400)) % 7;
}

int main(void)
{
    const char *months[] = {"January", "February", "March", "April", "May",
                            "June", "July", "August", "September", "October",
                            "November", "December"};
    int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    int year, m, d, i;
    int start;

    printf("Enter year: ");
    if (scanf("%d", &year) != 1 || year < 1) {
        printf("Invalid year.\n");
        return 1;
    }

    if (isLeap(year))
        days[1] = 29;

    start = firstDayOfYear(year);   /* weekday of 1 Jan */

    printf("\n========== Calendar for %d ==========\n", year);

    for (m = 0; m < 12; m++) {
        printf("\n---------- %s ----------\n", months[m]);
        printf(" Su  Mo  Tu  We  Th  Fr  Sa\n");

        /* leading blanks before the 1st */
        for (i = 0; i < start; i++)
            printf("    ");

        for (d = 1; d <= days[m]; d++) {
            printf("%3d ", d);
            if ((start + d) % 7 == 0)
                printf("\n");
        }
        printf("\n");

        /* weekday on which the next month starts */
        start = (start + days[m]) % 7;
    }
    return 0;
}
