#include <stdio.h>

int main() {
    char op;
    int a, b, result;

    printf("Enter two numbers:");
    scanf("%d %d", &a, &b);
    printf("Enter Operator(+,-,*,/):");
    scanf(" %c", &op);   // <-- space added here

    switch (op) {
    case '+':
        result = a + b;
        printf("Addition=%d", result);
        break;
    case '-':
        result = a - b;
        printf("Subtraction=%d", result);
        break;
    case '*':
        result = a * b;
        printf("Multiply=%d", result);
        break;
    case '/':
        result = a / b;
        printf("Division=%d", result);
        
        break;
    default:
        printf("Invalid Operation");
        break;
    }
    return 0;
}
